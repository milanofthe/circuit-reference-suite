{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case.schema.json",
  "title": "Circuit case",
  "type": "object",
  "required": ["id", "title", "family", "source", "files", "netlists"],
  "additionalProperties": false,
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "title": {"type": "string"},
    "family": {
      "enum": ["amplifier", "opamp", "ota", "comparator", "ldo", "bandgap", "reference",
               "oscillator", "mixer", "filter", "rectifier", "power", "logic", "arithmetic",
               "memory", "converter", "pll", "interconnect", "power_grid", "device",
               "passive", "behavioral", "test"],
      "description": "What the circuit is. device: a single-device characterization deck; test: a regression deck exercising simulator features."
    },
    "source": {"$ref": "common.schema.json#/$defs/source"},
    "files": {"$ref": "common.schema.json#/$defs/files"},
    "netlists": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "dialect"],
        "additionalProperties": false,
        "properties": {
          "file": {"type": "string"},
          "dialect": {"enum": ["ngspice", "xyce", "hspice", "pspice", "tspice", "spice3", "gnucap", "wrspice", "josim", "ltspice", "ahkab", "spicesharp", "cedarsim", "spectre", "vacask", "qucsator"]},
          "note": {"type": "string"},
          "resolve": {"$ref": "common.schema.json#/$defs/resolve"},
          "size": {"type": "integer", "minimum": 1, "description": "The size a generated case writes this netlist at."}
        }
      }
    },
    "resolve": {"$ref": "common.schema.json#/$defs/resolve"},
    "generator": {
      "type": "object",
      "description": "A case written by circref/generate.py, with the generator's parameters; netlists state their size.",
      "required": ["network", "r", "c", "source_r", "dc", "pulse", "tran"],
      "additionalProperties": false,
      "properties": {
        "network": {"enum": ["ladder", "mesh", "grid3d", "star", "ring", "random", "tree"]},
        "r": {"type": "number", "exclusiveMinimum": 0},
        "c": {"type": "number", "exclusiveMinimum": 0},
        "source_r": {"type": "number", "exclusiveMinimum": 0},
        "dc": {"type": "number", "description": "The source's DC value: the operating point is solved at it, the transient starts from the pulse."},
        "pulse": {
          "type": "object",
          "required": ["v1", "v2", "delay", "rise", "fall", "width", "period"],
          "additionalProperties": {"type": "number"}
        },
        "tran": {
          "type": "object",
          "required": ["step", "stop"],
          "additionalProperties": {"type": "number"}
        }
      }
    },
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  }
}
