<Project Sdk="Microsoft.NET.Sdk">

  <!-- Package versions come from sims/spicesharp.sh (the newest on nuget). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- not "spicesharp": assembly names compare case-insensitively, SpiceSharp is taken -->
    <AssemblyName>spicesharp-runner</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SpiceSharp-Parser" Version="$(SpiceSharpParserVersion)" />
    <PackageReference Include="SpiceSharpParser.CustomComponents" Version="$(CustomComponentsVersion)" />
  </ItemGroup>

</Project>
