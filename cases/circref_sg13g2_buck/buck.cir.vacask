Synchronous buck converter power stage, IHP SG13G2 high-voltage MOS
// 3.3 V at a duty cycle of 0.35 and 10 MHz into 12 Ohm, 0.96 V at the output: a PMOS of
// 2 mm and an NMOS of 1 mm in fingers
// of 10 um, driven with dead times of 3 ns and 2 ns, 1 uH with 50 mOhm and 10 nF,
// 50 pF at the switching node. Start from zero output, 100 switching periods.
include "vacask/models/sg13g2_vacask_common.lib"
include "vacask/models/cornerMOShv.lib" section=mos_tt
load "spice/resistor.osdi"
load "spice/capacitor.osdi"
load "spice/inductor.osdi"
model r sp_resistor
model c sp_capacitor
model l sp_inductor
model vsource vsource
vin (vin 0) vsource dc=3.3
vgp (gp 0) vsource type="pulse" val0=3.3 val1=0.0 delay=2e-09 rise=1e-09 fall=1e-09 width=3.4e-08 period=1e-07
vgn (gn 0) vsource type="pulse" val0=0.0 val1=3.3 delay=4e-08 rise=1e-09 fall=1e-09 width=5.7e-08 period=1e-07
xmp (sw gp vin vin) sg13_hv_pmos w=0.002 l=4.5e-07 ng=200.0
xmn (sw gn 0 0) sg13_hv_nmos w=0.001 l=4.5e-07 ng=100.0
csw (sw 0) c c=5e-11
l1 (sw lx) l l=1e-06
rl (lx out) r r=0.05
c1 (out 0) c c=1e-08
rload (out 0) r r=12.0
control
  save v(gp) v(gn) v(sw) v(out)
  analysis op1 op
  analysis tran1 tran step=1e-09 stop=1e-05
endc
