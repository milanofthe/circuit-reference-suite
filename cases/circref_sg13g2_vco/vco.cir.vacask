Current-starved ring oscillator with a control voltage step, IHP SG13G2 low-voltage MOS
// Five current-starved inverters and an output inverter. A current pulse into the first
// stage starts the oscillation; the control voltage steps from 0.7 V to 0.9 V at 40 ns.
include "vacask/models/sg13g2_vacask_common.lib"
include "vacask/models/cornerMOSlv.lib" section=mos_tt
load "spice/capacitor.osdi"
model c sp_capacitor
model vsource vsource
model isource isource
subckt stage(in out pb nb vdd)
xmp1 (ps pb vdd vdd) sg13_lv_pmos w=4e-06 l=5e-07
xmp2 (out in ps vdd) sg13_lv_pmos w=2e-06 l=1.3e-07
xmn2 (out in ns 0) sg13_lv_nmos w=1e-06 l=1.3e-07
xmn1 (ns nb 0 0) sg13_lv_nmos w=2e-06 l=5e-07
cl (out 0) c c=2e-14
ends
vdd (vdd 0) vsource dc=1.2
vctrl (nb 0) vsource type="pulse" val0=0.7 val1=0.9 delay=4e-08 rise=1e-09 fall=1e-09 width=1e-07 period=2e-07
ikick (0 n1) isource type="pulse" val0=0.0 val1=0.0001 delay=1e-10 rise=1e-10 fall=1e-10 width=5e-10 period=1.0
xmbn (pb nb 0 0) sg13_lv_nmos w=2e-06 l=5e-07
xmbp (pb pb vdd vdd) sg13_lv_pmos w=4e-06 l=5e-07
x1 (n1 n2 pb nb vdd) stage 
x2 (n2 n3 pb nb vdd) stage 
x3 (n3 n4 pb nb vdd) stage 
x4 (n4 n5 pb nb vdd) stage 
x5 (n5 n1 pb nb vdd) stage 
xpo (out n1 vdd vdd) sg13_lv_pmos w=2e-06 l=1.3e-07
xno (out n1 0 0) sg13_lv_nmos w=1e-06 l=1.3e-07
co (out 0) c c=1e-14
control
  save v(n1) v(n3) v(out) v(nb) v(pb)
  analysis op1 op
  analysis tran1 tran step=2e-11 stop=8e-08
endc
